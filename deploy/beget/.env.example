APP_NAME="НПП Инпроком"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ваш-домен.ru

STAFF_LOGIN_PATH=inprokom-staff

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL из панели Beget (не SQLite на продакшене)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Почта — свои данные
MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="НПП Инпроком"
MAIL_REPLY_TO=info@inprokom.ru
MAIL_REPLY_TO_NAME="НПП Инпроком"
MAIL_SITE_URL=https://ваш-домен.ru
MAIL_EHLO_DOMAIN=ваш-домен.ru

VITE_APP_NAME="${APP_NAME}"
