# Прокси Vite на Laravel API (локальная разработка)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Базовый URL API (оставьте пустым для прокси через Vite; в проде — полный URL бэкенда)
VITE_API_URL=

# Секретный путь входа сотрудников (должен совпадать с STAFF_LOGIN_PATH на бэкенде)
VITE_STAFF_LOGIN_PATH=inprokom-staff
